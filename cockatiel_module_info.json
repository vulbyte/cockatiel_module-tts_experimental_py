{
  "name": "tts-experimental-py",
  "description": "OPT-IN experimental text-to-speech for model families the default Rust tts-rs module does not support (XTTS, Kokoro, F5, MeloTTS, Chatterbox, MMS, etc.). Requires a working Python environment (pip packages are auto-installed on first run). Start it manually from the modules window; not auto-started by default.",
  "version": "0.1.0",
  "capabilities": "postprocess",
  "root_file": "./tts_service.py",
  "launch_command": "python3",
  "command_flags": [
    "./tts_service.py"
  ],
  "autostart": false,
  "price": 0,
  "min_rank": 0,
  "authority": 0,
  "credentials": [
    {
      "key": "model",
      "label": "Model (piper/xtts/kokoro/f5/melotts/chatterbox/mms)",
      "list": false,
      "sensitive": false
    },
    {
      "key": "model_source",
      "label": "Model source path",
      "list": false,
      "sensitive": false
    },
    {
      "key": "speaker_index",
      "label": "Speaker index",
      "list": false,
      "sensitive": false
    },
    {
      "key": "volume",
      "label": "Volume (0-1)",
      "list": false,
      "sensitive": false
    },
    {
      "key": "synthesis_concurrency",
      "label": "Synthesis concurrency",
      "list": false,
      "sensitive": false
    },
    {
      "key": "max_chars",
      "label": "Max chars per message",
      "list": false,
      "sensitive": false
    },
    {
      "key": "play_locally",
      "label": "Play audio locally",
      "list": false,
      "sensitive": false
    }
  ]
}
